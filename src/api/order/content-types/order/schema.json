{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "Research order requests and fulfilled orders"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "stripeSessionId": {
      "type": "string"
    },
    "stripePaymentIntentId": {
      "type": "string"
    },
    "customerName": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "companyName": {
      "type": "string"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "customerNotes": {
      "type": "text"
    },
    "amountSubtotal": {
      "type": "decimal",
      "required": true
    },
    "amountTotal": {
      "type": "decimal",
      "required": true
    },
    "shippingAmount": {
      "type": "decimal"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "orderNumber": {
      "type": "string",
      "unique": true
    },
    "subtotalCents": {
      "type": "integer",
      "min": 0
    },
    "shippingCents": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "taxCents": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "totalCents": {
      "type": "integer",
      "min": 0
    },
    "paymentProvider": {
      "type": "enumeration",
      "enum": ["moov"],
      "default": "moov"
    },
    "paymentMethod": {
      "type": "enumeration",
      "enum": ["card", "ach", "apple_pay"]
    },
    "paymentStatus": {
      "type": "enumeration",
      "enum": ["pending", "processing", "paid", "failed", "cancelled", "refunded"],
      "default": "pending"
    },
    "moovCustomerAccountId": {
      "type": "string"
    },
    "moovPaymentMethodId": {
      "type": "string"
    },
    "moovTransferId": {
      "type": "string"
    },
    "processedWebhookIds": {
      "type": "json"
    },
    "idempotencyKey": {
      "type": "string",
      "unique": true
    },
    "inventoryCommitted": {
      "type": "boolean",
      "default": false
    },
    "paidAt": {
      "type": "datetime"
    },
    "shippingName": {
      "type": "string"
    },
    "shippingAddressLine1": {
      "type": "string"
    },
    "shippingAddressLine2": {
      "type": "string"
    },
    "shippingCity": {
      "type": "string"
    },
    "shippingState": {
      "type": "string"
    },
    "shippingPostalCode": {
      "type": "string"
    },
    "shippingCountry": {
      "type": "string",
      "default": "US"
    },
    "confirmationAccepted": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending_review",
        "approved",
        "rejected",
        "awaiting_payment",
        "fulfilled",
        "cancelled"
      ],
      "default": "pending_review"
    },
    "inventoryAdjusted": {
      "type": "boolean",
      "default": false
    },
    "ownerNotes": {
      "type": "text"
    },
    "reviewedAt": {
      "type": "datetime"
    },
    "orderItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    }
  }
}
