# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# ── Database (Railway Postgres — copy DATABASE_URL from Railway Postgres service) ─
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Strapi Secrets — generate with: openssl rand -base64 32 ──────────────────
# APP_KEYS: comma-separated list of at least 2 random values
APP_KEYS=change_me_key1,change_me_key2,change_me_key3,change_me_key4
API_TOKEN_SALT=change_me
ADMIN_JWT_SECRET=change_me
TRANSFER_TOKEN_SALT=change_me
JWT_SECRET=change_me

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public URL of this Strapi service (used for media URL generation)
PUBLIC_URL=https://api.quantumbiopeptides.com
# Frontend URL (added to CORS allowlist)
FRONTEND_URL=https://quantumbiopeptides.com

# ── Cloudinary (media uploads — required in production) ───────────────────────
# If all three are set, Strapi uses Cloudinary. Otherwise falls back to local disk.
CLOUDINARY_NAME=peptides
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
